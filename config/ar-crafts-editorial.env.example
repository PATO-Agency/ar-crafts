# Separate LOCAL editorial profile; never load this into ar-crafts-demo.
# Copy to .env.ar-crafts-editorial.local (ignored). No account/dataset is provisioned.
AR_CONTENT_SOURCE=sanity
PATO_SITE_VISIBILITY=internal
PATO_LOCAL_INTERNAL=confirmed
# AR_REMOTE_DEMO and PATO_HOSTED_INTERNAL_PREVIEW must remain ABSENT.
SANITY_PROJECT_ID=
SANITY_DATASET=ar-crafts-editorial-test
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_REVALIDATION_TOKEN=
SANITY_WEBHOOK_SECRET=
SANITY_PREVIEW_SECRET=
SANITY_WEBHOOK_ID=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=ar-crafts-editorial-test
SANITY_STUDIO_PREVIEW_URL=http://127.0.0.1:3001
PATO_STUDIO_ORIGIN=http://127.0.0.1:3334
