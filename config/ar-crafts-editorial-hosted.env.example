# Private operator profile, distinct from .env.ar-crafts-editorial.local.
# Copy to .env.ar-crafts-editorial-hosted.local (ignored).
# Fill the actual protected HTTPS origin only after Vercel assigns it.
# This file does not authenticate users or provision provider protection.
AR_EDITORIAL_MODE=hosted
AR_EDITORIAL_ALLOWED_ORIGIN=
AR_EDITORIAL_AUTOMATION_BYPASS_SECRET=
# Separate Presentation access, only after explicit authorization to store it in
# the isolated private Sanity dataset (readable by authorized document readers).
AR_EDITORIAL_PRESENTATION_BYPASS_SECRET=
AR_CONTENT_SOURCE=sanity
PATO_SITE_VISIBILITY=internal
PATO_HOSTED_INTERNAL_PREVIEW=authenticated
# AR_REMOTE_DEMO and PATO_LOCAL_INTERNAL must remain ABSENT.
SANITY_PROJECT_ID=
SANITY_DATASET=ar-crafts-editorial-test
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_REVALIDATION_TOKEN=
SANITY_WEBHOOK_SECRET=
SANITY_PREVIEW_SECRET=
SANITY_WEBHOOK_ID=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=ar-crafts-editorial-test
SANITY_STUDIO_PREVIEW_URL=
PATO_STUDIO_ORIGIN=http://127.0.0.1:3334
# Optional exact hosted Studio origin, in addition to the local Studio.
PATO_HOSTED_STUDIO_ORIGIN=
# Public hosting identity; app ID is returned by the first Sanity deploy.
SANITY_STUDIO_HOST=ar-crafts-editorial-test
SANITY_STUDIO_APP_ID=
# SANITY_WRITE_TOKEN and AR_EDITORIAL_* stay on the operator's machine.
# Upload only the explicit server allowlist to the separate Vercel project.
